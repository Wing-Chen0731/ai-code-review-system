# GitHub App / webhook
GITHUB_APP_ID=replace-me
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=replace-me

# LLM gateway
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace-me
LLM_INPUT_PRICE_PER_1K_TOKENS_USD=0.00015
LLM_OUTPUT_PRICE_PER_1K_TOKENS_USD=0.00060

# Runtime
DATABASE_URL=postgresql+psycopg://review:review@postgres:5432/review
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

